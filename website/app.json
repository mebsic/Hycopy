{
  "name": "Hycopy Documentation",
  "description": "The Hycopy handbook at hycopy.net",
  "repository": "https://github.com/mebsic/Hycopy",
  "env": {
    "APP_BASE": {
      "description": "Website directory selected before the Node.js buildpack",
      "value": "website"
    },
    "SITE_URL": {
      "description": "Public origin used for canonical URLs and the sitemap",
      "value": "https://hycopy.net"
    }
  },
  "buildpacks": [
    { "url": "https://github.com/lstoll/heroku-buildpack-monorepo" },
    { "url": "heroku/nodejs" }
  ]
}
